# ============================================================
# Civil Cost Index Dashboard - environment variables
# ============================================================

# Common
APP_ENV=development
APP_VERSION=0.1.0

# --- Backend API (Cloudflare Worker) ---
# Neon PostgreSQL connection string (pooled endpoint). Production: Neon Secret.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Direct (non-pooled) connection string used by migrations.
DATABASE_URL_DIRECT=

# Optional security: when set, admin endpoints require X-Admin-Key header.
ADMIN_API_KEY=
# Optional HTTP Basic Auth for the whole API (complement Cloudflare Access).
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Comma separated origins allowed for browser access.
CORS_ORIGINS=http://localhost:3000,http://localhost:8787

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
