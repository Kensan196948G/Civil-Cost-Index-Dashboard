# ============================================================
# Civil Cost Index Dashboard - environment variables
# ============================================================

# Common
APP_ENV=development
APP_VERSION=0.1.0

# --- Backend API (Hono) ---
# Native開発用。Docker Composeは下記CCI_LOCAL_DATABASE_URLを使用する。
DATABASE_URL=
# マイグレーション用の直接接続文字列
DATABASE_URL_DIRECT=
# Docker Composeの専用Local PostgreSQL。変更する場合はpasswordとURLを同時に変更する。
CCI_DB_PASSWORD=
CCI_LOCAL_DATABASE_URL=
CCI_DB_HOST_PORT=15432
CCI_API_HOST_PORT=18000
CCI_WEB_HOST_PORT=3000
API_HOST=0.0.0.0
API_PORT=8000

# 管理APIキー（設定時、X-Admin-Key ヘッダー必須）
ADMIN_API_KEY=
# 任意: URL取込で許可するホスト（カンマ区切り、例: e-stat.go.jp,*.mlit.go.jp）
# 未設定の場合は http/https のパブリックホストを許可（SSRFガードはIPレベルで実施）
FETCH_ALLOWED_HOSTS=
# 任意: 定期取得・未更新通知の Webhook（Teams / Slack）
NOTIFY_TEAMS_URL=
NOTIFY_SLACK_URL=
# 任意: PDF日本語フォント（TTF/OTF）の取得URL。未設定時はデフォルトCDN
PDF_CJK_FONT_URL=
# 任意: AIプロバイダー（Anthropic / DeepSeek / Perplexity / Workers AI）
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
AI_PROVIDER=
AI_MODEL=
# 任意: RBAC 用 Cloudflare Access 設定
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# 任意: リバースプロキシ運用時に X-User-Email / X-User-Roles を信頼（true のみ有効）
AUTH_TRUST_PROXY=false
# 任意: API 全体の Basic 認証
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# 任意: 未認証アクセスを閲覧者として許可（デモ環境のみ。false なら未認証は 401）
ALLOW_ANONYMOUS_VIEWER=false
# Cloudflare互換経路のみtrue。LAN正本APIはfalseのまま使用する。
READ_ONLY_MODE=false
# 任意: IP単位のAPIレート制限（1分あたり）。0以下で無効。
RATE_LIMIT_PER_MINUTE=180
# ブラウザアクセスを許可するオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cci-web-assets.kensan1969.workers.dev

# --- Frontend ---
# 同一オリジン /api プロキシを使う場合は空のまま（LAN/systemd 運用の推奨）
NEXT_PUBLIC_API_BASE_URL=
# 同一オリジン /api の転送先（ネイティブ: http://127.0.0.1:8000 / Docker: http://api:8000）
API_PROXY_TARGET=http://127.0.0.1:8000
