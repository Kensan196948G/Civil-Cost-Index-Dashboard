# ============================================================
# Civil Cost Index Dashboard - environment variables
# ============================================================

# Common
APP_ENV=development
APP_VERSION=0.1.0

# --- Backend API (Hono) ---
# Neon PostgreSQL 接続文字列（pooled）。本番は Secret で管理。
DATABASE_URL=
# マイグレーション用ダイレクト（非プール）接続文字列
DATABASE_URL_DIRECT=
API_HOST=0.0.0.0
API_PORT=8000

# 管理APIキー（設定時、X-Admin-Key ヘッダー必須）
ADMIN_API_KEY=
# 任意: API 全体の Basic 認証
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# ブラウザアクセスを許可するオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cci-web-assets.kensan1969.workers.dev

# --- Frontend ---
# 同一オリジン /api プロキシを使う場合は空のまま（LAN/systemd 運用の推奨）
NEXT_PUBLIC_API_BASE_URL=
# 同一オリジン /api の転送先（ネイティブ: http://127.0.0.1:8000 / Docker: http://api:8000）
API_PROXY_TARGET=http://127.0.0.1:8000
