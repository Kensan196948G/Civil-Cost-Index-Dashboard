{
  "name": "cci-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  // 定期取得・未更新通知（毎日 16:00 UTC = 01:00 JST）
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  // Workers AI バインディング（AI市況サマリー等のフォールバック用。ANTHROPIC_API_KEY 設定時はそちらを優先）
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "CORS_ORIGINS": "http://localhost:3000,http://localhost:8787,https://cci-web-assets.kensan1969.workers.dev,https://ccid.mirai-dx-platform.com",
    "READ_ONLY_MODE": "true",
    "REQUEST_LOGGING": "true"
  }
}
