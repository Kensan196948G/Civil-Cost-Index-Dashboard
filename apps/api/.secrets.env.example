# ============================================================
# CCI シークレットファイル（Git管理外）
# このファイルに値を入れて保存し、以下を実行するだけです。
#   cd apps/api
#   npm run secrets:cloudflare   # Cloudflare Worker へ反映＋デプロイ＋確認
#   npm run secrets:local        # 本機LAN（/etc/cci/cci.env）へ反映＋再起動
#   npm run secrets:sync         # 両方まとめて
# （事前確認は npm run secrets:cloudflare -- --dry-run）
# ============================================================

# 管理APIキー（X-Admin-Key）※システム管理者用
# 未設定時は一部の管理APIが開発用フォールバックで空欄でも通過します。本番では必ず設定してください。
# 生成例: openssl rand -hex 32
ADMIN_API_KEY=

# AIプロバイダー
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# ANTHROPIC_API_KEY=
# AI_PROVIDER=deepseek          # anthropic / deepseek / perplexity / workers-ai / none
# AI_MODEL=

# 通知・RBAC・PDF（任意）
# NOTIFY_TEAMS_URL=
# NOTIFY_SLACK_URL=
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# PDF_CJK_FONT_URL=
