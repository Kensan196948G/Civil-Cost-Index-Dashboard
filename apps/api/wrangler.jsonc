{
  "name": "cci-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "CORS_ORIGINS": "http://localhost:3000,http://localhost:8787,https://cci-web-assets.kensan1969.workers.dev"
  }
}
