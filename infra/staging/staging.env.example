# CCI staging API 環境変数の雛形（秘密値を含まない）
#
#   cp infra/staging/staging.env.example ~/.config/cci/staging.env
#   chmod 600 ~/.config/cci/staging.env
#
# ADMIN_API_KEY は人間が生成して追記する。値はリポジトリ・ログ・PRに残さない。
# 未設定でも匿名viewerの読み取りは動作する（管理APIは fail closed で 401）。

DATABASE_URL=postgresql://kensan@/cci_staging?host=/var/run/postgresql&sslmode=disable
DATABASE_URL_DIRECT=postgresql://kensan@/cci_staging?host=/var/run/postgresql&sslmode=disable

# コンテナ内ポート。compose は 127.0.0.1:18806 -> 8000 を公開する。
PORT=8000
APP_ENV=production
APP_VERSION=0.1.0-staging
ALLOW_ANONYMOUS_VIEWER=true
CORS_ORIGINS=https://ccid-mvp-staging.mirai-dx-platform.com,https://cci-web-mvp-staging.kensan1969.workers.dev
RATE_LIMIT_PER_MINUTE=300
REQUEST_LOGGING=true

# 管理API・監査CSVを有効にする場合のみ設定（人間が投入）
# ADMIN_API_KEY=
