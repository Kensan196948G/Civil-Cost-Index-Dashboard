[Unit]
Description=Civil Cost Index Dashboard (Docker Compose: PostgreSQL + API + Web)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/opt/cci
EnvironmentFile=/etc/cci/cci.env
ExecStart=/usr/bin/docker compose -p cci -f /opt/cci/docker-compose.yml up -d --wait --wait-timeout 300
ExecStop=/usr/bin/docker compose -p cci -f /opt/cci/docker-compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
